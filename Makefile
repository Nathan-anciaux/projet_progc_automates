# CC=gcc or clang or gcc-14 (on OSX)
CC=gcc

# If a scanner+parser is needed.
LEX=flex
YACC=bison
YFLAGS=-d -v -t # -Wcounterexamples

# Math, big numbers and SDL2 fonts
LDLIBS=-ll  -lreadline -lm # -lgmp -lSDL2_ttf -lSDL2_mixer

# The DEBUG_LEVEL (OFF, CRITICAL, ERROR, WARNING, INFO, TRACE)
# is set by default to WARNING in macros_error.h.
# To set it on the command line, force compilation and set it.
# Example: make -B CFLAGS="-DDEBUG_LEVEL=INFO" to see all debug messages
# above the 'INFO' level.

# clang 14.0.3 does implement the C23 feature __VA_OPTS__ but issues a spurious
# warning. The -Wno-gnu-zero-variadic-macro-arguments disables this warning.
# This flag is ignored by gcc (which implements __VA_OPTS__ without any warning).

# For MacOS (assuming recent homebrew)
ifeq ($(shell uname -s), Darwin)
override CFLAGS += -std=gnu2x -MMD -Wall -pedantic -Wextra -Wshadow -Wpointer-arith	\
-Wcast-qual -Wstrict-prototypes -Wmissing-prototypes -Wno-gnu-zero-variadic-macro-arguments
	CPPFLAGS += -I/opt/homebrew/include -I/opt/homebrew/include/json-c
	LDFLAGS += -L/opt/homebrew/lib -L/opt/homebrew/lib
endif

ifeq ($(shell uname -s), Linux)
override CFLAGS += -std=gnu2x -MMD -Wall -pedantic -Wextra -Wshadow -Wpointer-arith	\
-Wcast-qual -Wstrict-prototypes -Wmissing-prototypes -Wno-comments -D_GNU_SOURCE
	CPPFLAGS += -I/usr/include -I/usr/include/json-c
endif


LDLIBS += $(shell sdl2-config --libs)
LDLIBS += -ljson-c
LDFLAGS += $(shell sdl2-config --cflags)

SOURCES := $(wildcard *.c *.c)
OBJECTS := $(SOURCES:%.c=%.o)
DEPS := $(SOURCES:%.c=%.d)

# Compilation in debug mode by default, to use gdb and valgrind. Warnings produce an error.
all: CFLAGS += -g -O0 # -Werror
all: lea

# Once the program works, optimized mode (and no error in case of warning).
nowerror: CFLAGS += -O3
nowerror: lea

# Add parser.o scan.o if bison/flex interface.
lea: $(OBJECTS) system_parser.tab.o system_scan.o system_parse_regexp.tab.o system_scan_regexp.o $(OBJECTS)
	$(CC) -o $@ $(LDFLAGS) $(CFLAGS) $^ $(LDLIBS)

system_parse_regexp.tab.c: system_parse_regexp.y system_parse_regexp.h
	$(YACC) $(YFLAGS) --name-prefix regexp_ system_parse_regexp.y

system_parser.tab.c system_parser.tab.h: system_parser.y system_parser.h
	$(YACC) $(YFLAGS) --name-prefix shell_ system_parser.y

system_scan_regexp.c: system_scan_regexp.l system_parse_regexp.tab.c
	flex -t --prefix regexp_ system_scan_regexp.l > system_scan_regexp.c

system_scan.c: system_scan.l
	flex -t --prefix shell_ system_scan.l > system_scan.c

# Include dependancies generated by gcc -MMD.
-include $(DEPS)

# Clean all.
.PHONY: clean
clean:
	rm -rf lea *.tab.* *.o *.d TAGS core *.output lex.yy.c system_scan_regexp.c system_scan_regexp.c system_scan.c /tmp/nfa-*

